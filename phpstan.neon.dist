includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    treatPhpDocTypesAsCertain: false
    rememberPossiblyImpureFunctionValues: false
    paths:
        - elementor-json-bridge.php
        - uninstall.php
        - includes
    scanFiles:
        - tests/stubs/elementor.php
    tmpDir: .phpstan-cache
