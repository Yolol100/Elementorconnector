<?xml version="1.0"?>
<ruleset name="Elementor JSON Bridge"><description>WordPress security/API conventions plus PHP 8.3+ compatibility.</description><file>elementor-json-bridge.php</file><file>uninstall.php</file><file>includes</file><exclude-pattern>vendor/*</exclude-pattern><arg name="basepath" value="."/><arg name="colors"/><arg value="sp"/><rule ref="WordPress-Core"><exclude name="Universal.Arrays.DisallowShortArraySyntax"/><exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/><exclude name="WordPress.Files.FileName.InvalidClassFileName"/></rule><rule ref="WordPress-Extra"><exclude name="Universal.Arrays.DisallowShortArraySyntax"/><exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/><exclude name="WordPress.Files.FileName.InvalidClassFileName"/></rule><rule ref="PHPCompatibilityWP"><properties><property name="testVersion" value="8.3-"/></properties></rule><config name="minimum_supported_wp_version" value="6.8"/></ruleset>
