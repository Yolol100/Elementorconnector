<?xml version="1.0"?>
<ruleset name="Elementor JSON Bridge">
  <description>WordPress coding and PHP 8.1+ compatibility rules.</description>
  <file>elementor-json-bridge.php</file>
  <file>uninstall.php</file>
  <file>includes</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="WordPress-Core"/>
  <rule ref="PHPCompatibilityWP">
    <properties>
      <property name="testVersion" value="8.1-"/>
    </properties>
  </rule>
  <config name="minimum_supported_wp_version" value="6.8"/>
</ruleset>
