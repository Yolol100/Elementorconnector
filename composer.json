{"name":"webactueel/elementor-json-bridge","description":"Development tooling for the Elementor JSON Bridge WordPress plugin.","type":"wordpress-plugin","license":"GPL-2.0-or-later","require":{"php":">=8.3"},"require-dev":{"dealerdirect/phpcodesniffer-composer-installer":"^1.1","phpcompatibility/phpcompatibility-wp":"^2.1.8","phpstan/phpstan":"^2.2","squizlabs/php_codesniffer":"^3.13","szepeviktor/phpstan-wordpress":"^2.0.3","wp-coding-standards/wpcs":"^3.4.1"},"config":{"allow-plugins":{"dealerdirect/phpcodesniffer-composer-installer":true},"sort-packages":true},"scripts":{"lint":"find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l","test":"php tests/run.php","phpcs":"phpcs --standard=phpcs.xml.dist elementor-json-bridge.php uninstall.php includes","phpstan":"phpstan analyse --configuration=phpstan.neon.dist --no-progress","qa":["@lint","@test","@phpcs","@phpstan"]}}
